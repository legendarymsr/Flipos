# build outputs & caches (never committed; resumable across thermal kills)
/out/
/dl/
/ccache/
/buildroot/output/
*.log
logs/*.log
# private signing keys — only the public part is tracked
keys/*.key
keys/*.pem
!keys/*.pub
# release: guest images are bundled at package time, not committed
release/kernelsu-module/payload/images/*
!release/kernelsu-module/payload/images/.gitkeep
