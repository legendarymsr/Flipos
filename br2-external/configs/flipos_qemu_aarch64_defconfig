# flipos — Buildroot defconfig for QEMU aarch64 (virt).
# Pins are REAL/verified upstream (Buildroot 2026.02.3 LTS, Linux 6.18.57 LTS).
# NOTE: exact Kconfig symbol names are re-validated when Buildroot first runs in
# Phase 1 (`make image`); any that moved are corrected there, never invented.

# Architecture: generic ARMv8-A so userland runs on any aarch64 (incl. TCG -cpu
# max) without SIGILL; CPU-specific tuning is avoided on purpose.
BR2_aarch64=y
BR2_ARM_CPU_ARMV8A=y

# C library: glibc — chosen for later WebKitGTK browser + GTK4 compatibility
# (musl is smaller but WebKit on musl is fragile). Justified in docs/PACKAGES.md.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
# Custom kernel => Buildroot must be told the headers series, or glibc's
# prerequisites are unknown and it silently falls back to uClibc.
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Reproducibility + resumable builds.
BR2_REPRODUCIBLE=y
BR2_CCACHE=y

# Init: Buildroot offers no s6 init choice (verified against 2026.02.3), so the
# first bootable image uses BusyBox init (not systemd). s6-linux-init as PID 1
# is a tracked follow-up (docs/LIMITATIONS.md).
BR2_INIT_BUSYBOX=y
# EROFS root is read-only by design: don't try to remount it rw at boot.
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# Serial console login (dev builds: no root password).
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_SEATD=y

# Kernel: mainline LTS 6.18.57, arm64 defconfig + our hardening/virtio fragment.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.57"
BR2_LINUX_KERNEL_DEFCONFIG="defconfig"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FLIPOS_PATH)/board/flipos/linux.fragment"
BR2_LINUX_KERNEL_IMAGE=y

# Root filesystem: read-only EROFS (compressed). data.img (ext4) is made at
# first run by scripts/run.sh, not baked here.
BR2_TARGET_ROOTFS_EROFS=y
BR2_TARGET_ROOTFS_EROFS_LZ4HC=y
# No initramfs for now; root= points at the EROFS virtio-blk.

# Rootfs overlay (service defs, /etc/flipos, policy).
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_FLIPOS_PATH)/board/flipos/rootfs-overlay"

# Post scripts: assemble images with genimage.
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_FLIPOS_PATH)/board/flipos/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_FLIPOS_PATH)/board/flipos/post-image.sh"
BR2_PACKAGE_HOST_GENIMAGE=y

# Minimal extras (justify each in docs/PACKAGES.md as packages are added).
BR2_TARGET_GENERIC_HOSTNAME="flipos"
BR2_TARGET_GENERIC_ISSUE="flipos"
BR2_SYSTEM_DHCP="eth0"

# ---- Phase 2: Wayland compositor + terminal ----
# Buildroot's wlroots hard-requires EGL + GLES + GBM, so Mesa is needed at build
# time. We use the softpipe software driver (no LLVM); at RUN time flipos-session
# still selects the pixman renderer. foot is the terminal; flipos-wm is ours.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# foot needs at least one font.
BR2_PACKAGE_DEJAVU=y
# Formats the /data image on first boot.
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_WLROOTS=y
BR2_PACKAGE_FOOT=y
BR2_PACKAGE_FLIPOS_WM=y

# ---- App package manager: pacman (installs flipos apps into /data) ----
BR2_PACKAGE_PACMAN=y
BR2_PACKAGE_GNUPG2=y
